<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>xyz.wheretolive.db-backup</string>
    <!-- Run via wtl-pyrun.sh + the FDA-granted venv python3 (NOT plain bash):
         in production the checkout is in a TCC-protected folder, and only the
         granted python binary may read the .db files / write the marker under
         launchd. See the backup_dbs.py header. WorkingDirectory stays OUT of
         the checkout (the service user's home) so wtl-pyrun.sh's (ungranted)
         bash never getcwd()s it. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/wtl-pyrun.sh</string>
        <string>/opt/wheretolive/venv/bin/python3</string>
        <string>/opt/wheretolive/scripts/backup_dbs.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>&lt;set-me&gt;</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key><string>&lt;set-me&gt;</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>20</integer></dict>
    <key>RunAtLoad</key><false/>
    <key>StandardOutPath</key>
    <string>/var/log/wheretolive/db-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/wheretolive/db-backup.log</string>
</dict>
</plist>
